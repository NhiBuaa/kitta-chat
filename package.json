{
  "scripts": {
    "test:ci": "node --test scripts/ci/*.test.cjs",
    "ci:validate": "node scripts/ci/validateCiContract.cjs",
    "lint": "npm --prefix client run lint",
    "lint:ci": "npm --prefix client run lint:ci",
    "license:check": "license-checker-rseidelsohn --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD\" --summary",
    "dev:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "dev:docker:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "seed:demo": "docker compose exec -T backend npm run seed:demo",
    "demo": "node scripts/demo.js",
    "demo:observability": "node scripts/observabilityDemo.js",
    "prod:docker": "docker compose up --build"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "lucide-react": "^1.7.0"
  },
  "devDependencies": {
    "license-checker-rseidelsohn": "4.4.2",
    "yaml": "^2.9.0"
  }
}
