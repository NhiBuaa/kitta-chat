{
  "annotations": { "list": [] },
  "description": "K3 aggregate observability dashboard. Metrics are aggregate operation signals only; use structured logs and correlation IDs for lifecycle tracing.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Accepted Socket.IO namespace / socket instances across the selected backend replicas.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kittachat_socket_active_connections{instance=~\"$instance\"})",
          "legendFormat": "active sockets",
          "refId": "A"
        }
      ],
      "title": "Active sockets",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Aggregate HTTP 5xx request rate across selected replicas.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(kittachat_http_requests_total{status_class=\"5xx\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "5xx requests/s",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Ratio of aggregate HTTP requests that completed with a 5xx status class.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(kittachat_http_requests_total{status_class=\"5xx\",instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(kittachat_http_requests_total{instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Aggregate total HTTP request rate across selected replicas.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 11,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(kittachat_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "all requests/s",
          "refId": "A"
        }
      ],
      "title": "Total HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "p50 HTTP duration from the aggregate histogram; `le` is retained while aggregating buckets.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kittachat_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        }
      ],
      "title": "HTTP latency p50",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "p95 HTTP duration from the aggregate histogram; `le` is retained while aggregating buckets.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 5,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kittachat_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "HTTP latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Failed Mongo-backed persistence operations as a fraction of all timed persistence operations.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 6,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(kittachat_message_persistence_duration_seconds_count{outcome=\"failed\",instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(kittachat_message_persistence_duration_seconds_count{instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "persistence failure ratio",
          "refId": "A"
        }
      ],
      "title": "Message persistence failure ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Redis command failures are separate from application cache-fallback decisions.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 7,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (operation) (rate(kittachat_redis_operations_total{outcome=\"error\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} errors/s",
          "refId": "A"
        }
      ],
      "title": "Redis command errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Application cache fallbacks, independent from Redis command error outcomes.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 8,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (reason) (rate(kittachat_cache_fallbacks_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{reason}} fallbacks/s",
          "refId": "A"
        }
      ],
      "title": "Cache fallbacks",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Queue delivery outcomes after their approved terminal disposition boundary.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 9,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (queue, job_type, outcome) (rate(kittachat_queue_jobs_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{queue}} {{job_type}} {{outcome}}/s",
          "refId": "A"
        }
      ],
      "title": "Queue outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Dead-letter events in the selected dashboard range. A non-zero value is severe under the current invariant.",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 10,
      "options": { "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true }, "noValue": "No data", "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (queue, job_type, reason) (increase(kittachat_queue_dead_lettered_total{reason=~\"poison|retry_exhausted\",instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{queue}} {{job_type}} {{reason}}",
          "refId": "A"
        }
      ],
      "title": "Queue dead-letter events",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["k3", "kittachat", "observability"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "hide": 0,
        "includeAll": true,
        "label": "Backend instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values(kittachat_http_requests_total, instance)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "KittaChat K3 Observability",
  "uid": "kittachat-k3-observability",
  "version": 1,
  "weekStart": ""
}
